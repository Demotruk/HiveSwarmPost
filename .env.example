# Required: @swarmpost account's posting key (never commit this)
POSTING_KEY=5K...

# Bot account name (default: swarmpost)
BOT_ACCOUNT=swarmpost

# Set to true to log actions without broadcasting to the blockchain
DRY_RUN=false

# Watchdog: force exit(1) if a run hasn't finished within this many minutes, so
# a hung network read can't keep a Fly scheduled machine in `started` and block
# every future run. Applies to all three entry points. Default 30.
# RUN_TIMEOUT_MINUTES=30

# Test mode: posts with "DO NOT UPVOTE" warnings, broken @mentions,
# and separate permlinks/tags. Use with a test account.
TEST_MODE=false

# Trust API backend URL (default: https://swarm-trust-api.fly.dev)
# TRUST_API_URL=https://swarm-trust-api.fly.dev

# Sync bot's follow list with eligible newbie pool (default: false)
# SYNC_FOLLOWS=false

# Reblog feed bots — reblog newbie intro posts onto feed accounts.
# Run with: npm run reblog-feeds
# Feed 1: Trusted network newbies (shared account, free)
# TRUSTED_FEED_ACCOUNT=swarmpost-newbies
# TRUSTED_FEED_POSTING_KEY=5K...
# TRUSTED_FEED_WINDOW_DAYS=30
# Feed 2: All new users (shared account, free)
# ALL_FEED_ACCOUNT=hive-newbies
# ALL_FEED_POSTING_KEY=5K...
# ALL_FEED_WINDOW_DAYS=10
# Feed 3: Personal trust network (per-subscriber, paid)
# PERSONAL_FEED_ENABLED=false
# BOT_ACTIVE_KEY=5K...
# REBLOG_FEED_MASTER_SECRET=<random secret for key derivation>
# REBLOG_FEED_DELEGATION_VESTS=15.000000 VESTS
# REBLOG_FEED_ACCOUNT_PREFIX=nf-
# REBLOG_FEED_PAYMENT_AMOUNT=0.500 HBD
# REBLOG_FEED_PAYMENT_MEMO=feed3
# Shared reblog feed config
# REBLOG_FEED_DATA_DIR=./data/reblog-feeds

# RC delegation — auto-delegate resource credits to trustworthy newbies with
# a qualifying intro post, reclaimed once they age out of the window.
# Run with: npm run rc-delegate
# RC_DELEGATION_ENABLED=false
# RC_DELEGATOR_ACCOUNT=<separate funded account>
# RC_DELEGATOR_POSTING_KEY=5K...   # posting key of the delegator account
# RC_DELEGATION_AMOUNT=15000000000 # RC per newbie (15B default)
# RC_DELEGATION_BATCH_SIZE=100     # delegatees per custom_json op
# Accounts the bot must never reclaim from or delegate to — for manual RC
# delegations made from the delegator account outside the newbie programme.
# Comma-separated; added to the built-in list in src/config.ts (not a replacement).
# RC_DELEGATION_EXEMPT_ACCOUNTS=hivepostify,someotheraccount
# Second guard: only delegations matching an amount this bot hands out are ever
# reclaimed, so any manually-sized delegation is safe without being listed above.
# If you change RC_DELEGATION_AMOUNT, add the OLD value here or delegations made
# under it can never be reclaimed. Comma-separated raw RC units.
# RC_DELEGATION_PAST_AMOUNTS=10000000000,5000000000

# Optional tuning (defaults shown)
# ELIGIBILITY_WINDOW_DAYS=30
# ACTIVITY_CAP=10
# TRUST_ATTENUATION=0.5
# TRUST_DEPTH_CAP=4
# VOTER_WINDOW_DAYS=7
# ROUNDS_PER_DAY=10
# NEWBIES_PER_ROUND=1
